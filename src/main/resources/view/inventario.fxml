<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="500.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.vyorg.reclutamiento.controller.InventarioController">
    <top>
        <VBox alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Region HBox.hgrow="ALWAYS" />
                <VBox alignment="CENTER" spacing="5.0">
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Inventario de aspirantes" />
                    <Button onAction="#cerrarSesion" text="Cerrar sesión" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="etiquetaRol" style="-fx-font-weight: bold; -fx-text-fill: #333333;" text="Rol: Usuario" />
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tablaAspirantes" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="columnaId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="columnaNombre" prefWidth="120.0" text="Nombre" />
                <TableColumn fx:id="columnaApellido" prefWidth="120.0" text="Apellido" />
                <TableColumn fx:id="columnaCorreo" prefWidth="180.0" text="Correo" />
                <TableColumn fx:id="columnaTelefono" prefWidth="110.0" text="Teléfono" />
                <TableColumn fx:id="columnaDireccion" prefWidth="170.0" text="Dirección" />
                <TableColumn fx:id="columnaEdad" prefWidth="60.0" text="Edad" />
            </columns>
        </TableView>
    </center>
    <right>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <Label text="Nombre" />
            <TextField fx:id="campoNombre" />
            <Label text="Apellido" />
            <TextField fx:id="campoApellido" />
            <Label text="Correo" />
            <TextField fx:id="campoCorreo" />
            <Label text="Teléfono" />
            <TextField fx:id="campoTelefono" />
            <Label text="Dirección" />
            <TextField fx:id="campoDireccion" />
            <Label text="Edad" />
            <TextField fx:id="campoEdad" />
            <Button onAction="#agregar" text="Agregar" />
            <Button onAction="#actualizar" text="Actualizar" />
            <Button onAction="#eliminar" text="Eliminar" />
            <Button onAction="#limpiar" text="Limpiar" />
        </VBox>
    </right>
</BorderPane>